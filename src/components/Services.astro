---
import { services } from '../data/site.js';
---

<section class="section" id="services">
  <div class="section-label reveal">02 / What I Do</div>
  <h2 class="section-heading reveal">Capabilities</h2>
  <div class="services-grid dim-siblings">
    {services.map((service, i) => (
      <div class="service-card glass-card reveal">
        <span class="service-index">{String(i + 1).padStart(2, '0')}</span>
        <span class="service-icon">{service.icon}</span>
        <h3>{service.title}</h3>
        <p>{service.description}</p>
      </div>
    ))}
  </div>
</section>
