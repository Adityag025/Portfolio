---
import { profile } from '../data/site.js';
---

<section class="section contact" id="contact">
  <div class="section-label reveal">08 // Connect</div>
  <h2 class="section-heading reveal">Have a project in mind?</h2>
  <p class="contact-text reveal">
    I'm open to new opportunities, interesting projects and good ideas.
    Let's build something exceptional together.
  </p>
  <a href={`mailto:${profile.email}`} class="btn btn-dark magnetic reveal">
    Start a Conversation <span class="arrow">→</span>
  </a>
  <div class="contact-directory">
    <a href={profile.github} target="_blank" rel="noopener noreferrer" class="directory-card glass-card reveal">
      <div><small>Social_Directory</small>GitHub</div>
      <span class="arrow">↗</span>
    </a>
    <a href={`mailto:${profile.email}`} class="directory-card glass-card reveal">
      <div><small>Email_Address</small>{profile.email}</div>
      <span class="arrow">↗</span>
    </a>
    <a href={profile.phoneHref} class="directory-card glass-card reveal">
      <div><small>Direct_Line</small>{profile.phone}</div>
      <span class="arrow">↗</span>
    </a>
    <a href={profile.resume} download="Aditya-Gupta-Resume.pdf" class="directory-card glass-card reveal">
      <div><small>Latest_Resume</small>Aditya-Gupta-Resume.pdf</div>
      <span class="arrow">↓</span>
    </a>
  </div>
</section>
