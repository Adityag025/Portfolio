---
import { skillGroups, marqueeSkills } from '../data/site.js';
// Track is rendered twice for a seamless -50% loop
---

<section id="skills">
  <div class="section" style="padding-bottom: 2.5rem;">
    <div class="section-label reveal">02 / Stack</div>
    <h2 class="section-heading reveal">Tools of the Trade</h2>
  </div>

  <div class="marquee-section" aria-hidden="true">
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="marquee-track">
          {marqueeSkills.map((skill) => (
            <>
              <span class="word">{skill}</span>
              <span class="sep">◆</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="section" style="padding-top: 3rem;">
    <div class="skills-groups dim-siblings">
      {skillGroups.map((group) => (
        <div class="skill-group glass-card reveal">
          <h3>{group.title}</h3>
          <div class="chips">
            {group.skills.map((skill) => <span class="chip">{skill}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
