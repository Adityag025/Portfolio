---
import { projects } from '../data/site.js';
// Asymmetric editorial grid like the Stitch design: 8/4, then 6/6, then 4/4/4 fallback
const spans = ['span-8', 'span-4', 'span-6', 'span-6', 'span-6', 'span-6'];
---

<section class="section" id="projects">
  <div class="section-label reveal">04 / Selected Work</div>
  <h2 class="section-heading reveal">Curated Projects</h2>
  <div class="projects-grid dim-siblings">
    {projects.map((project, i) => (
      <article class={`project-card glass-card reveal ${spans[i] ?? 'span-6'}`}>
        <div class="project-visual">
          <span class="project-icon">{project.icon}</span>
        </div>
        <div class="project-body">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="tags">
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
