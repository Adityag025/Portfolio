---
import { awards } from '../data/site.js';
---

<section class="section" id="awards">
  <div class="section-label reveal">05 / Recognition</div>
  <h2 class="section-heading reveal">Awards &amp; Certifications</h2>
  <div class="awards-list">
    {awards.map((award) => (
      <div class="award-row glass-card reveal">
        <span class="award-year">{award.year}</span>
        <div class="award-info">
          <h3>{award.title}</h3>
          <p>{award.org}</p>
        </div>
        <span class="award-mark" aria-hidden="true">✦</span>
      </div>
    ))}
  </div>
</section>
